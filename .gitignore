```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js
*.ts
*.tsx

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
.coverage

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# Temporary files
*.tmp
*.temp
*.bak

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Testing
.mypy_cache/
.pytest_cache/
.nyc_output/
coverage/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java
*.class
*.jar
*.war
*.ear
target/
.gradle/

# C/C++
*.o
*.a
*.obj
*.out
*.exe
*.dll
*.so

# Go
*.exe
*.test
*.prof

# Ruby
*.gem
*.rbc
.bundle/
vendor/bundle/

# Rust
target/

# Julia
julia-*/

# Zig
zig*/
```