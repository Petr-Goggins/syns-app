```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js
*.css

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary files
*.tmp
*.temp

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Package manager caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled files
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.obj
*.out

# Compression
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```